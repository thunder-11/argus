# ═══════════════════════════════════════════════════════════
# CFAS — Crypto Fraud Attribution System
# Environment Configuration & API Keys
# ═══════════════════════════════════════════════════════════

# ── Server & Security Settings ───────────────────────────
DATABASE_URL=sqlite:///./cfas.db
SECRET_KEY=cfas-production-secret-key-change-in-prod-2026

# ── Blockchain API Keys ──────────────────────────────────
# Put your API keys below to fetch live mainnet transactions:
# 1. Etherscan API Key (Ethereum mainnet & ERC-20 tokens)
#    Get key at: https://etherscan.io/apis
ETHERSCAN_API_KEY=

# 2. TronGrid API Key (TRON mainnet, TRX, and TRC-20 USDT)
#    Get key at: https://www.trongrid.io
TRONGRID_API_KEY=

# 3. BscScan API Key (BNB Chain mainnet & BEP-20 tokens)
#    Get key at: https://bscscan.com/apis
BSCSCAN_API_KEY=

# 4. Alchemy / QuickNode / Blockstream (Optional)
ALCHEMY_API_KEY=

# Note: If API keys are left blank, CFAS automatically runs in
# Smart Demo Mode, generating realistic multi-hop forensic trace paths.
