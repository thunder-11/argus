# ═══════════════════════════════════════════════════════════
# SIH26183 backend local development configuration
# Copy to .env and replace placeholders locally. Never commit .env.
# ═══════════════════════════════════════════════════════════

# ── Application & Security ───────────────────────────────
APP_ENV=development
APP_VERSION=1.3.0-phase3
LOG_LEVEL=INFO
DATA_MODE=fixture
DEMO_ENABLED=true
DATABASE_URL=sqlite:///./cfas.db
JWT_SECRET_KEY=<placeholder-development-secret>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
REFRESH_TOKEN_EXPIRE_HOURS=168
PII_ENCRYPTION_KEY=<placeholder-separate-data-protection-key>
REPORT_TIME_MAX_FUTURE_SKEW_SECONDS=300
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLED_CHAINS=BTC,ETH,TRON,BSC,POLYGON

# ── Blockchain API Keys ──────────────────────────────────
# Put your API keys below to fetch live mainnet transactions:
# 1. Etherscan API Key (Ethereum mainnet & ERC-20 tokens)
#    Get key at: https://etherscan.io/apis
ETHERSCAN_API_KEY=<placeholder>
ETHERSCAN_BASE_URL=https://api.etherscan.io/api
ETHEREUM_RPC_URL=<placeholder>

# 2. TronGrid API Key (TRON mainnet, TRX, and TRC-20 USDT)
#    Get key at: https://www.trongrid.io
TRONGRID_API_KEY=<placeholder>
TRONSCAN_API_KEY=<placeholder>
TRONGRID_BASE_URL=https://api.trongrid.io

# 3. BscScan API Key (BNB Chain mainnet & BEP-20 tokens)
#    Get key at: https://bscscan.com/apis
BSCSCAN_API_KEY=<placeholder>
BSCSCAN_BASE_URL=https://api.bscscan.com/api
BSC_RPC_URL=<placeholder>

# 4. Polygon and Bitcoin
POLYGONSCAN_API_KEY=<placeholder>
POLYGONSCAN_BASE_URL=https://api.polygonscan.com/api
POLYGON_RPC_URL=<placeholder>
BLOCKSTREAM_BASE_URL=https://blockstream.info/api

# Fixture data is used only when DATA_MODE=fixture and DEMO_ENABLED=true.
# Production must use DATA_MODE=live, DEMO_ENABLED=false, an explicit CORS
# allowlist, a strong JWT secret, and credentials for every enabled chain.

REPORTS_DIR=./reports
NOTICES_DIR=./notices
DEFAULT_MAX_HOPS=4
MAX_HOP_LIMIT=6
MIN_AMOUNT_FILTER_USD=50
TX_CACHE_TTL_HOURS=6

# Phase 2 persistence and durable processing
# PostgreSQL is authoritative outside explicit local/test fixture mode.
# Example: postgresql+psycopg://<user>:<password>@<host>:5432/<database>
NEO4J_URI=<placeholder>
NEO4J_USER=<placeholder>
NEO4J_PASSWORD=<placeholder>
REDIS_CACHE_URL=<placeholder>
REDIS_REGISTRY_URL=<placeholder>
CELERY_BROKER_URL=<placeholder>
CELERY_RESULT_BACKEND=<placeholder>
JOB_LEASE_SECONDS=60
JOB_MAX_ATTEMPTS=5
OUTBOX_BATCH_SIZE=100
